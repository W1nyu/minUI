{
  "name": "@minui/harvester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "harvest": "tsx src/cli.ts",
    "recall": "tsx src/measure-recall.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe": "tsx src/probe.ts",
    "build:snippet": "esbuild src/snippet-entry.ts --bundle --format=iife --target=es2020 --outfile=out/harvest-snippet.js --banner:js=\"/* MinUI 수집 스니펫 — 로그인한 사이트의 콘솔에 붙여넣으세요 */\"",
    "verify:snippet": "tsx src/verify-snippet.ts",
    "docs": "tsx src/docs-cli.ts"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
